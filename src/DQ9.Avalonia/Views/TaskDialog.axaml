<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DQ9.Avalonia.Views.TaskDialog"
        x:CompileBindings="False"
        Title="{Binding Title}"
        Width="420" MinHeight="150" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Topmost="True">

  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Name="TitleText" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0" />
  </StackPanel>
</Window>
