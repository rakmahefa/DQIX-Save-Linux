<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DQ9.Avalonia.ViewModels.Screens"
             x:Class="DQ9.Avalonia.Views.Screens.TreasureMapsScreen"
             x:DataType="vm:TreasureMapsScreenViewModel">
  <Grid ColumnDefinitions="280,*" RowDefinitions="Auto,*" Margin="8">
    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="{DynamicResource ControlGapSmall}" Margin="0,0,0,6">
      <Button Content="New map" Click="OnNew" ToolTip.Tip="Generate a new map in the first free slot." />
      <!-- UX-16: destructive action styled and confirmed. -->
      <Button Content="Delete" Classes="danger" Click="OnDelete" ToolTip.Tip="Remove the selected map (asks for confirmation)." />
      <Button Content="Up" Click="OnUp" ToolTip.Tip="Move the selected map up." />
      <Button Content="Down" Click="OnDown" ToolTip.Tip="Move the selected map down." />
    </StackPanel>
    <ListBox Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}">
      <ListBox.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ScrollViewer Grid.Column="1" Grid.Row="1">
      <WrapPanel>
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="group">Map flags</TextBlock>
            <TextBlock Classes="readout" Text="{Binding MapCountText, StringFormat='Maps: {0} / 99'}" />
            <TextBlock Classes="lbl">State</TextBlock>
            <ComboBox Width="{DynamicResource FieldMediumWidth}" ItemsSource="{Binding StateOptions}"
                      SelectedItem="{Binding SelectedStateOption}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="lbl">Rank</TextBlock>
            <TextBox Width="{DynamicResource FieldMicroWidth}" Text="{Binding Rank}" />
            <TextBlock Classes="lbl">Type</TextBlock>
            <ComboBox Width="{DynamicResource FieldMediumWidth}" ItemsSource="{Binding TypeOptions}"
                      SelectedItem="{Binding SelectedTypeOption}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="lbl">Devil level</TextBlock>
            <TextBox Width="{DynamicResource FieldMicroWidth}" Text="{Binding DevilLevel}" />
            <TextBlock Classes="lbl">Detector</TextBlock>
            <TextBox Width="{DynamicResource FieldMediumWidth}" Text="{Binding Detector}"
                     ToolTip.Tip="Player who shared the map — unreadable characters are bytes that do not map to game text." />
            <TextBlock Classes="lbl">Renewer</TextBlock>
            <TextBox Width="{DynamicResource FieldMediumWidth}" Text="{Binding Renewer}"
                     ToolTip.Tip="Player who renewed the map — unreadable characters are bytes that do not map to game text." />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="group">Grotto details</TextBlock>
            <!-- UX-17: the invalid-map note names existing controls and warns in color. -->
            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" MaxWidth="360"
                       Classes.warning="{Binding DetailsIsWarning}" />
            <TextBlock Classes="lbl">Treasure boxes</TextBlock>
            <TextBlock Text="{Binding Boxes}" TextWrapping="Wrap" MaxWidth="360" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
